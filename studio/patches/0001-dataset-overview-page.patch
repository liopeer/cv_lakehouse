+import { describe, it, expect } from 'vitest';
+import { render, screen } from '@testing-library/svelte';
+import { SampleType, type CollectionOverviewView } from '$lib/api/lightly_studio_local';
+import DatasetOverview from './DatasetOverview.svelte';
+
+const datasets: CollectionOverviewView[] = [
+    {
+        collection_id: 'images-1',
+        name: 'Street scenes',
+        sample_type: SampleType.IMAGE,
+        created_at: new Date('2026-02-01T10:00:00Z'),
+        total_sample_count: 1234
+    },
+    {
+        collection_id: 'videos-1',
+        name: 'Drone flights',
+        sample_type: SampleType.VIDEO,
+        created_at: new Date('2026-01-01T10:00:00Z'),
+        total_sample_count: 7
+    }
+];
+
+describe('DatasetOverview', () => {
+    it('lists every dataset with its sample count and a link to the dataset', () => {
+        render(DatasetOverview, { props: { datasets } });
+
+        expect(screen.getByText('Street scenes').closest('a')).toHaveAttribute(
+            'href',
+            '/datasets/images-1/image/images-1'
+        );
+        expect(screen.getByText('Drone flights').closest('a')).toHaveAttribute(
+            'href',
+            '/datasets/videos-1/video/videos-1'
+        );
+        expect(screen.getByText('1,234 samples')).toBeInTheDocument();
+        expect(screen.getByText('7 samples')).toBeInTheDocument();
+    });
+
+    it('shows an empty state when there are no datasets', () => {
+        render(DatasetOverview, { props: { datasets: [] } });
+
+        expect(screen.getByText('No datasets yet')).toBeInTheDocument();
+        expect(screen.queryByTestId('dataset-overview-list')).not.toBeInTheDocument();
+    });
+});
