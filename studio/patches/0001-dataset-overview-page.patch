+<script lang="ts">
+    import type { CollectionOverviewView } from '$lib/api/lightly_studio_local';
+    import { Badge } from '$lib/components/ui/badge';
+    import { routeHelpers } from '$lib/routes';
+    import { formatDate } from '$lib/utils';
+    import { Database } from '@lucide/svelte';
+
+    interface Props {
+        datasets: CollectionOverviewView[];
+    }
+
+    let { datasets }: Props = $props();
+
+    const toDataset = (dataset: CollectionOverviewView) =>
+        routeHelpers.toCollectionHome(
+            dataset.collection_id,
+            dataset.sample_type.toLowerCase(),
+            dataset.collection_id
+        );
+</script>
+
+<section class="mx-auto w-full max-w-5xl px-8 py-8">
+    <h1 class="mb-6 text-2xl font-semibold text-foreground">Datasets</h1>
+
+    {#if datasets.length === 0}
+        <div
+            class="flex flex-col items-center gap-3 rounded-xl border border-border bg-card p-12 text-center"
+            data-testid="dataset-overview-empty"
+        >
+            <Database class="size-10 text-muted-foreground" />
+            <p class="text-lg font-medium text-foreground">No datasets yet</p>
+            <p class="text-sm text-muted-foreground">
+                Load a dataset with the LightlyStudio Python package, then refresh this page.
+            </p>
+        </div>
+    {:else}
+        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-testid="dataset-overview-list">
+            {#each datasets as dataset (dataset.collection_id)}
+                <li>
+                    <a
+                        href={toDataset(dataset)}
+                        class="flex h-full flex-col gap-3 rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary"
+                    >
+                        <div class="flex items-start justify-between gap-2">
+                            <span class="break-all font-medium text-foreground">{dataset.name}</span
+                            >
+                            <Badge variant="secondary">{dataset.sample_type.toLowerCase()}</Badge>
+                        </div>
+                        <div class="mt-auto flex justify-between text-sm text-muted-foreground">
+                            <span>{dataset.total_sample_count.toLocaleString('en-US')} samples</span
+                            >
+                            <span>{formatDate(dataset.created_at)}</span>
+                        </div>
+                    </a>
+                </li>
+            {/each}
+        </ul>
+    {/if}
+</section>
