# `.env` holds this machine's paths and settings. The image takes its settings from the
# environment it runs in.
.env

# The lake itself, when CV_LAKEHOUSE_ROOT is left at its default.
data/

# Not part of a code location. `triton/` and `studio/` build their own images. The
# lock names studio as a member, so its pyproject.toml stays for `uv sync`.
triton/
studio/*
!studio/pyproject.toml
**/tests/
docs/
dev/
