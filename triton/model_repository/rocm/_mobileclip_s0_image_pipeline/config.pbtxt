name: "_mobileclip_s0_image_pipeline"
backend: "python"
parameters {
  key: "steps"
  value: {
    string_value: "_mobileclip_s0_image_preprocessing:images,_mobileclip_s0_image_backend:embeddings"
  }
}
max_batch_size: 64
input [
  {
    name: "IMAGE_PATH"
    data_type: TYPE_UINT8
    dims: [ -1 ]
  },
  {
    name: "CROP_X"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "CROP_Y"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "CROP_WIDTH"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "CROP_HEIGHT"
    data_type: TYPE_INT64
    dims: [ 1 ]
  }
]
output [
  {
    name: "embeddings"
    data_type: TYPE_FP32
    dims: [ 512 ]
  }
]
instance_group [
  {
    kind: KIND_CPU
    count: 4
  }
]
