# The Python packages of the ROCm base image. `make lock` compiles this file into
# requirements-rocm.txt.

# The PyTorch builds for ROCm bundle the ROCm libraries, so the image needs no /opt/rocm.
# torch pulls pytorch-triton-rocm, which torch.compile needs.
torch==2.14.1+rocm7.2
torchvision==0.29.1+rocm7.2
# The Python backend expects numpy 1.
numpy==1.26.4
