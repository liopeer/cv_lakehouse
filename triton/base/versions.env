# Every input of the two base images. The Makefile passes each line as a build argument.
# A new base image changes this file, then builds and pushes.

# Triton 25.12 is server 2.64.0.
TRITON_VERSION=2.64.0
TRITON_CONTAINER_VERSION=25.12

# One Ubuntu archive state for every apt install, from snapshot.ubuntu.com.
UBUNTU_SNAPSHOT=20260919T000000Z
# ubuntu:24.04 has no CA certificates, so it cannot reach the snapshot over HTTPS. The
# ROCm image first installs these versions from the plain archive. They are the versions
# of the snapshot, and a bump of the snapshot bumps them too.
CA_CERTIFICATES_APT_VERSION=20260601~24.04.1
OPENSSL_APT_VERSION=3.0.13-0ubuntu3.15

# The images by digest.
CUDA_DEVEL_IMAGE=nvidia/cuda:13.1.0-devel-ubuntu24.04@sha256:7f32ae6e575abb29f2dacf6c75fe94a262bb48dcc5196ac833ced59d9fde8107
CUDA_RUNTIME_IMAGE=nvidia/cuda:13.1.0-runtime-ubuntu24.04@sha256:17b999b6882af79f41995f4807c32335734434d91ff0f6cdeaabc9115e7dab64
ROCM_DEVEL_IMAGE=rocm/dev-ubuntu-24.04:7.2.4@sha256:bdc8e61026cbb844ede93d44d2c50055f51ebb2041906b60182bf3bee3139054
UBUNTU_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

# The Triton repositories at r25.12, by commit.
TRITON_SERVER_COMMIT=f6d01881f53a23541fec034e68a9e4b2a744e319
TRITON_CORE_COMMIT=8dbcc963764d89f842886711b338ab32ee403f64
TRITON_COMMON_COMMIT=c09e98a47d721fea51913eb3737d37a45d34b431
TRITON_BACKEND_COMMIT=3901aa5e51a86ada253ae9ce44f82bcb81fe08b2
TRITON_THIRD_PARTY_COMMIT=84a6bacf4f2982024d1466485e89cb29b8925b6a
TRITON_PYTHON_BACKEND_COMMIT=397eddfcee0bdc6051c4317cea2ff752b79ef9b4
TRITON_TENSORRT_BACKEND_COMMIT=12b98531758dccd3476d87c0dc9e3475fae41988
TRITON_DALI_BACKEND_COMMIT=e85eb4eade79628931e46dfb7e96001c9bc8fe7d

# AMD's forks of the same repositories. `common` has no fork. AMD forks server and the
# onnxruntime backend for ROCm 7.2.3, and the others only for ROCm 7.2.
ROCM_SERVER_COMMIT=73a1f95296e36c2823e65f14d32ad8606c934036
ROCM_CORE_COMMIT=c5884e50a1dbd33c154eae0d2bb08c7e4e0d16ce
ROCM_BACKEND_COMMIT=0c25401b2a6898a87c7f8db81b7be9c65d7016b0
ROCM_THIRD_PARTY_COMMIT=89daec311d80655509729d396d8d65a8c4ad4194
ROCM_PYTHON_BACKEND_COMMIT=d1a494f4a4e3f50da6d1ee35b960d9308045bf95
ROCM_ONNXRUNTIME_BACKEND_COMMIT=85ef380248dd9ead1171f4fd3b3e934b90902b35

ROCPYDECODE_COMMIT=e387d1cd6637d9391b6a8409a6916d70ee04cc9c

# The TensorRT that the CUDA 13 build of Triton 25.12 runs, from NVIDIA's CUDA apt repo.
TENSORRT_APT_VERSION=10.14.1.48-1+cuda13.0

# The versioned ROCm apt repository never changes, so the suffix pins every ROCm package.
ROCM_VERSION=7.2.4
ROCM_APT_SUFFIX=70204-93~24.04

# AMD's build of ONNX Runtime with the MIGraphX execution provider, and the headers of the
# same release.
ONNXRUNTIME_VERSION=1.23.2
ONNXRUNTIME_MIGRAPHX_WHEEL=https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/onnxruntime_migraphx-1.23.2-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl
ONNXRUNTIME_MIGRAPHX_WHEEL_SHA256=ee8edeb2ba6a8d99b3043b23e812423e6f10333b508e003fc77b0feda197449f
ONNXRUNTIME_HEADERS_ARCHIVE=https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-linux-x64-1.23.2.tgz
ONNXRUNTIME_HEADERS_ARCHIVE_SHA256=1fa4dcaef22f6f7d5cd81b28c2800414350c10116f5fdd46a2160082551c5f9b

# The boost headers that Triton core needs, as build.py's own build image installs them.
BOOST_ARCHIVE=https://archives.boost.io/release/1.80.0/source/boost_1_80_0.tar.gz
BOOST_ARCHIVE_SHA256=4b2136f98bdd1f5857f1c3dea9ac2018effe65286cf251534b6ae20cc45e1847
